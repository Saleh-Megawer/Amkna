#navbar {
    padding: 10px 1rem;

    transition:
        color,
        background-color 0.2s linear;

    .navbar-brand {
        img {
            width: 65px;
            object-fit: contain;
            margin-right: 5px;
        }
        strong {
            font-size: 22px;
            font-weight: 900;
            vertical-align: middle;
        }
    }

    .nav-item {
        &:last-of-type {
            .nav-link {
                margin-right: 0px;
                padding-right: 0px;
            }
        }
        .nav-link {
            margin: 0px 5px;
            font-weight: 300;
        }
    }

    .btn-request {
        border: solid 1px #cccccc;
        padding: 10px 20px !important;
        border-radius: var(--border-radius);
        img {
            display: inline-block;
            width: 30px;
        }
    }

    .navbar-toggler {
        position: relative;
        width: 30px;

        .icon-1,
        .icon-2,
        .icon-3 {
            background-color: var(--navbar-color);
            position: absolute;
            transition: all 0.1s linear;
            border-radius: 25px;
            width: 100%;
            height: 3px;
            right: 0px;
        }

        .icon-1 {
            top: 0px;
        }

        .icon-2 {
            top: 8px;
        }

        .icon-3 {
            top: -8px;
        }
    }

    .dropdown-menu {
        right: 0px;
        min-width: 200px;
        background-color: #182433;
        border: 0px;
        padding: 10px;
        border-radius: 3px;
        a {
            color: #fff !important;
            border-radius: 2px;
        }
        .dropdown-item {
            padding: 10px 20px;
            border-bottom: dashed 1px #9e9e9e54;
            &:last-of-type {
                border-bottom: 0px;
            }
            &:hover {
                background-color: var(--brand-main-color);
            }
        }

        &::after {
            content: "";
            position: absolute;
            top: -5px;
            right: 35px;
            background-color: #182433;
            width: 20px;
            height: 20px;
            transform: rotate(45deg);
            z-index: -1;
        }
    }
}

.active-navbar-toggler {
    .icon-1 {
        top: 0px;
        right: 0px;
        transform: rotate(45deg);
    }

    .icon-2 {
        top: 8px;
        right: 0px;
        display: none;
    }

    .icon-3 {
        top: 0px !important;
        right: 0px !important;
        transform: rotate(-45deg);
    }
}

/*
|
| Navbar Themes
|
*/

@mixin navbarMainTheme {
    // border-bottom: 1px solid var(--border-color);
    background-color: var(--navbar-bg) !important;
    box-shadow: var(--navbar-shadow);

    .navbar-brand {
        color: var(--text-black) !important;
    }

    .nav-link {
        color: var(--navbar-color) !important;
    }

    // Icon
    .icon-1,
    .icon-2,
    .icon-3 {
        background-color: var(--navbar-color) !important;
    }
}

.nav-main-theme {
    @include navbarMainTheme();
}

.nav-transparent {
    background-color: transparent !important;
    box-shadow: unset;
    .navbar-brand,
    .nav-link {
        color: var(--text-black) !important;
    }
    .navbar-brand {
        strong {
            display: none;
        }
    }

    // Icon
    .icon-1,
    .icon-2,
    .icon-3 {
        background-color: var(--navbar-color-white) !important;
    }
}
.light-nav-link {
    .nav-link {
        color: #ffffff !important;
    }
    .download-cv{

        a{
            border-color: #fff;
            background-color: #fff !important;
            &:before{
                display: none;
            }
            span{
                color: var(--brand-main-color);
            }
        }
    }
}

@media (max-width: 1198px) {
    #navbar {
        .dropdown-menu {
            &::after {
                top: 38px !important;
                right: 28px;
            }
        }
    }
}

@media (max-width: 768px) {
    #navbar {
        .btn-request {
            display: block;
            width: 100% !important;
            text-align: center;
        }
        // img {
        //     width: 40px !important;
        //     margin-left: 5px !important;
        // }
        // Links Margin
        .nav-link {
            margin: 3px 0px !important;
        }
        .brand-text {
            margin-top: 10px;
            font-size: 18px;
        }
        .slogin {
            font-size: 16.5px !important;
            display: none;
        }
    }

    .second-navbar-nav {
        .nav-item {
            padding-bottom: 15px;
        }
    }
}

@media (max-width: 991px) {
    .nav-transparent {
        @include navbarMainTheme();
    }
}

